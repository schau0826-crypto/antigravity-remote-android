<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root_container"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ag_bg">

    <org.mozilla.geckoview.GeckoView
        android:id="@+id/gecko_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Subtle top progress bar while navigating -->
    <ProgressBar
        android:id="@+id/page_progress"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="2dp"
        android:layout_gravity="top"
        android:indeterminate="false"
        android:max="100"
        android:progressDrawable="@android:drawable/progress_horizontal"
        android:progressTint="@color/ag_primary"
        android:visibility="gone" />

    <!-- Smooth cold-start / initial load overlay -->
    <LinearLayout
        android:id="@+id/loading_overlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/ag_bg"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="32dp"
        android:visibility="visible">

        <ImageView
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:contentDescription="@string/app_name"
            android:src="@drawable/ic_launcher_foreground" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="@string/loading_connecting"
            android:textColor="@color/ag_text_primary"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tv_loading_subhint"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="@string/loading_subhint"
            android:textColor="@color/ag_text_secondary"
            android:textSize="12sp" />

        <ProgressBar
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="160dp"
            android:layout_height="4dp"
            android:layout_marginTop="18dp"
            android:indeterminate="true"
            android:indeterminateTint="@color/ag_primary" />

        <Button
            android:id="@+id/btn_retry_load"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="@string/loading_retry"
            android:textColor="@color/ag_primary"
            android:visibility="gone" />
    </LinearLayout>

    <!-- Draggable right-edge floating handle for quick menu -->
    <FrameLayout
        android:id="@+id/fab_quick_menu"
        android:layout_width="42dp"
        android:layout_height="wrap_content"
        android:minHeight="48dp"
        android:layout_gravity="top|end"
        android:alpha="0.88"
        android:background="@drawable/bg_floating_pill"
        android:contentDescription="@string/quick_menu_desc"
        android:elevation="8dp">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingTop="8dp"
            android:paddingBottom="8dp">

            <ImageView
                android:layout_width="17dp"
                android:layout_height="17dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_quick_menu" />

            <TextView
                android:id="@+id/tv_fab_ctx_pct"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:fontFeatureSettings="tnum"
                android:textColor="@color/ag_text_primary"
                android:textSize="9sp"
                android:textStyle="bold"
                android:visibility="gone" />
        </LinearLayout>

        <View
            android:id="@+id/view_fab_status_dot"
            android:layout_width="7dp"
            android:layout_height="7dp"
            android:layout_gravity="top|start"
            android:layout_marginStart="6dp"
            android:layout_marginTop="5dp"
            android:background="@drawable/bg_status_dot"
            android:visibility="gone" />
    </FrameLayout>

    <!-- In-app OAuth / Google Sign-In popup overlay -->
    <LinearLayout
        android:id="@+id/popup_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/ag_bg"
        android:elevation="12dp"
        android:orientation="vertical"
        android:visibility="gone">

        <LinearLayout
            android:id="@+id/popup_header"
            android:layout_width="match_parent"
            android:layout_height="46dp"
            android:background="@color/ag_surface"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="14dp"
            android:paddingEnd="10dp">

            <TextView
                android:id="@+id/popup_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:singleLine="true"
                android:text="@string/popup_default_title"
                android:textColor="@color/ag_text_primary"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/btn_close_popup"
                style="@style/AgToolbarButton"
                android:text="@string/popup_close" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/ag_border" />

        <org.mozilla.geckoview.GeckoView
            android:id="@+id/popup_gecko_view"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />
    </LinearLayout>

</FrameLayout>

{
  "manifest_version": 2,
  "name": "Antigravity Remote 中文汉化",
  "version": "1.0.3",
  "description": "Built-in Simplified Chinese UI localization, mobile polish, and foreground stream recovery for Google Antigravity Remote Control.",
  "browser_specific_settings": {
    "gecko": {
      "id": "ag-remote-zh@agremote.local"
    }
  },
  "permissions": [
    "nativeMessaging",
    "nativeMessagingFromContent",
    "geckoViewAddons",
    "storage",
    "tabs",
    "https://antigravity.google.com/*",
    "https://*.antigravity.google.com/*",
    "https://antigravity.google/*",
    "https://*.antigravity.google/*",
    "https://antigravity.static.usercontent.goog/*",
    "https://*.usercontent.goog/*"
  ],
  "background": {
    "scripts": [
      "background.js"
    ]
  },
  "content_scripts": [
    {
      "matches": [
        "https://antigravity.google.com/*",
        "https://*.antigravity.google.com/*",
        "https://antigravity.google/*",
        "https://*.antigravity.google/*"
      ],
      "js": [
        "preconnect.js"
      ],
      "run_at": "document_start",
      "all_frames": false
    },
    {
      "matches": [
        "https://antigravity.google.com/*",
        "https://*.antigravity.google.com/*",
        "https://antigravity.google/*",
        "https://*.antigravity.google/*",
        "https://antigravity.static.usercontent.goog/*",
        "https://*.usercontent.goog/*"
      ],
      "js": [
        "dict_zh.js",
        "translator.js",
        "content.js"
      ],
      "css": [
        "mobile_polish.css"
      ],
      "run_at": "document_idle",
      "all_frames": true
    }
  ]
}
